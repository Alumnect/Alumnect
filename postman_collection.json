{
  "info": {
    "name": "AlumNect Platform API Collection",
    "description": "Tập hợp toàn bộ 100% REST APIs thực tế của nền tảng Mạng xã hội & Hướng nghiệp Cựu sinh viên FPT University (AlumNect).\nBao gồm đầy đủ Header Authorization Bearer Token, Body mẫu chuẩn, Biến môi trường và Tests script tự động lưu Token.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080/api/v1",
      "type": "string"
    },
    {
      "key": "accessToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "refreshToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "adminAccessToken",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
