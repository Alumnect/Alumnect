            "body": {
              "mode": "raw",
              "raw": "{\n  \"fullName\": \"Nguyễn Văn An\",\n  \"email\": \"student.an@fpt.edu.vn\",\n  \"password\": \"Password@123\",\n  \"role\": \"STUDENT\",\n  \"majorId\": 1,\n  \"cohort\": 18,\n  \"studentCode\": \"SE180001\"\n}"
