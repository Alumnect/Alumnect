# Copy to .env.local and adjust per environment.
# Base URL of the AlumNect Spring Boot REST API.
VITE_API_BASE_URL=http://localhost:8080/api/v1

# 'true' enforces auth + RBAC route guards and calls the real auth API.
# Leave 'false' (or unset) for demo/dev without a backend.
VITE_REQUIRE_AUTH=false

# MapTiler – bản đồ nền quốc tế & Việt Nam (đăng ký miễn phí tại maptiler.com)
# Giới hạn Allowed HTTP origins tại dashboard MapTiler:
#   - Development: http://localhost:5173
#   - Production: https://your-domain.com
VITE_MAPTILER_API_KEY=your_maptiler_api_key_here
VITE_MAPTILER_STYLE_ID=streets-v4

# Vietnam Islands GeoJSON Overlay – Hoàng Sa / Trường Sa
# Để trống để tự động sử dụng tệp GeoJSON cục bộ tích hợp sẵn trong public (/vietnam-islands.geojson).
# Hoặc điền đường dẫn URL tùy chỉnh nếu muốn cấu hình từ xa.
VITE_VIETNAM_ISLANDS_GEOJSON_URL=
