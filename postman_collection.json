              "raw": "{\n  \"fullName\": \"Phạm Hoàng Dũng\",\n  \"email\": \"alumni.dung@gmail.com\",\n  \"password\": \"Password@123\",\n  \"role\": \"ALUMNI\",\n  \"majorId\": 1,\n  \"cohort\": 14,\n  \"studentCode\": \"SE140101\",\n  \"graduationYear\": 2022,\n  \"proofUrl\": \"https://pub-77de501eb1a440df9c8ca37a5886ddf8.r2.dev/proof-dung.jpg\",\n  \"note\": \"Cựu sinh viên K14 FPTU Hà Nội\"\n}"
            }
          }
        },
        {
          "name": "1.4 Đăng nhập User (Tự động lưu Token)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    var res = pm.response.json();",
                  "    if (res.data && res.data.accessToken) {",
                  "        pm.collectionVariables.set('accessToken', res.data.accessToken);",
                  "        pm.collectionVariables.set('refreshToken', res.data.refreshToken);",
                  "        console.log('Saved accessToken for User: ' + res.data.email);",
                  "    }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"student.an@fpt.edu.vn\",\n  \"password\": \"Password@123\"\n}"
            }
          }
        },
        {
          "name": "1.5 Đăng nhập Quản trị viên (ADMIN)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    var res = pm.response.json();",
                  "    if (res.data && res.data.accessToken) {",
                  "        pm.collectionVariables.set('adminAccessToken', res.data.accessToken);",
                  "        console.log('Saved adminAccessToken');",
                  "    }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/login",
