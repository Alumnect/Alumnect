# =====================================================================
# BẢN MẪU BIẾN MÔI TRƯỜNG DỰ ÁN ALUMNECT (.env.example)
# Sao chép tệp này thành '.env' và điền thông tin cấu hình thực tế của bạn.
# =====================================================================

# 1. Cấu hình cơ sở dữ liệu PostgreSQL
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=alumnect
DB_PORT=5432

# 2. Cấu hình dịch vụ gửi thư (Gmail SMTP)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_app_password

JWT_SECRET=MTIzNDU2NDU5OThEMzIxM0F6eGMzNTE2NTQzMjEzMjE2NTQ5OHEzMTNhMnMxZDMyMnp4M2MyMQ==
# Access Token: 24 giờ (86400000 ms)
JWT_EXPIRATION=86400000
# Refresh Token: 7 ngày (604800000 ms)
JWT_REFRESH_EXPIRATION=604800000

# 4. Cấu hình Cloudflare R2 (S3-compatible)
R2_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
R2_ACCESS_KEY=your-r2-access-key-id
R2_SECRET_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=alumnect
R2_PUBLIC_URL=https://pub-your-id.r2.dev

# 5. Cấu hình Frontend (Sử dụng qua Vite envDir)
VITE_API_BASE_URL=http://localhost:8080/api/v1
VITE_REQUIRE_AUTH=false

