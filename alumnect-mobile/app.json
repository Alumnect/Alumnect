{
  "expo": {
    "name": "Alumnect",
    "slug": "alumnect-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "vn.edu.fpt.alumnect"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-image",
      "expo-web-browser",
      "expo-local-authentication",
      "@react-native-community/datetimepicker",
      "@react-native-google-signin/google-signin",
      [
        "expo-media-library",
        {
          "photosPermission": "Alumnect cần quyền truy cập ảnh để lưu mã QR thanh toán.",
          "savePhotosPermission": "Alumnect cần quyền lưu ảnh để lưu mã QR thanh toán vào thư viện.",
          "isAccessMediaLocationEnabled": false
        }
      ]
    ],
    "scheme": "alumnect",
    "experiments": {
      "typedRoutes": false
    }
  }
}
